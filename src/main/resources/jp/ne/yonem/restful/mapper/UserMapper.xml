<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.ne.yonem.restful.mapper.UserMapper">

    <!-- Userオブジェクトとテーブルカラムのマッピング結果セット -->
    <resultMap id="userResultMap" type="jp.ne.yonem.restful.entity.User">
        <id property="id" column="id"/>
        <result property="userName" column="username"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="roles" column="roles"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 新しいユーザーを挿入します。 -->
    <insert id="insert" parameterType="jp.ne.yonem.restful.entity.User" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO users (username, email, password, roles)
        VALUES (#{userName}, #{email}, #{password}, #{roles})
    </insert>

    <!-- IDに基づいてユーザーを検索します。 -->
    <select id="findById" parameterType="int" resultMap="userResultMap">
        SELECT id, username, email, password, roles, created_at
        FROM users
        WHERE id = #{id}
    </select>

    <!-- メールアドレスに基づいてユーザーを検索します。 -->
    <select id="findByEmail" parameterType="string" resultMap="userResultMap">
        SELECT id, username, email, password, roles, created_at
        FROM users
        WHERE email = #{email}
    </select>

    <!-- すべてのユーザーを取得します。 -->
    <select id="findAllUsers" resultMap="userResultMap">
        SELECT id, username, email, password, roles, created_at
        FROM users
    </select>

    <!-- ユーザー情報を更新します。 -->
    <update id="updateUser" parameterType="jp.ne.yonem.restful.entity.User">
        UPDATE users
        SET
        username = #{userName},
        email = #{email},
        password = #{password},
        roles = #{roles}
        WHERE id = #{id}
    </update>

    <!-- IDに基づいてユーザーを削除します。 -->
    <delete id="deleteUser" parameterType="int">
        DELETE FROM users
        WHERE id = #{id}
    </delete>
</mapper>